alert tls $EXTERNAL_NET 443 -> $HOME_NET any (msg:"LOCAL GENERIC TLS server cert with Email= in subject (malware-generated cert)"; flow:established,to_client; tls.cert_subject; content:"Email="; classtype:trojan-activity; sid:1000101; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1573.002;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL GENERIC TLS to external IP without SNI"; flow:established,to_server; tls.sni; absent; classtype:bad-unknown; sid:1000102; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1071.001;)
alert dns $HOME_NET any -> any 53 (msg:"LOCAL GENERIC DNS lookup of external IP-check service"; dns.query; pcre:"/(?:myexternalip|ipify|icanhazip|ifconfig\.(?:me|co)|ipinfo\.io|checkip\.|whatismyip|ip-api|ident\.me|wtfismyip|ipecho|ipapi|myip\.)/i"; classtype:policy-violation; sid:1000103; rev:1; metadata:mitre_tactic_id TA0007, mitre_technique_id T1016;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL GENERIC TLS SNI of external IP-check service"; flow:established,to_server; tls.sni; pcre:"/(?:myexternalip|ipify|icanhazip|ifconfig\.(?:me|co)|ipinfo\.io|checkip\.|whatismyip|ip-api|ident\.me|wtfismyip|ipecho|ipapi|myip\.)/i"; classtype:policy-violation; sid:1000104; rev:1; metadata:mitre_tactic_id TA0007, mitre_technique_id T1016;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"LOCAL GENERIC Beaconing: 10+ new connections to same external IP in 20 min"; flow:to_server; flags:S,12; threshold:type threshold, track by_dst, count 10, seconds 1200; classtype:trojan-activity; sid:1000105; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1029;)
